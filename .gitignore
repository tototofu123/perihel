# Perihel monorepo — gitignore

# --- local-agent (Rust workspace) ---
/local-agent/target
/local-agent/.merge-tmp

# Model weights + the sherpa-onnx runtime are fetched by
# local-agent/scripts/download-models.ps1, never committed (hundreds of MB).
/local-agent/models/bin/
/local-agent/models/lib/
local-agent/models/**/*.gguf
local-agent/models/**/*.onnx
local-agent/models/**/*.bin
local-agent/models/**/*.ggml
local-agent/models/**/*.tar.bz2
local-agent/models/**/*.zip
local-agent/models/**/*.exe
local-agent/models/**/*.dll
local-agent/training/.venv
local-agent/training/base
local-agent/training/out
local-agent/training/llama.cpp

# --- server (VM) ---
# Your real VM address/token/topic live here — never committed.
# Copy server/local.env.example to server/local.env and fill it in.
server/local.env

# --- mobile (Android) ---
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties
mobile/.idea/
*.jks
*.keystore

# --- misc ---
*.log
*.swp
.DS_Store
Thumbs.db
__pycache__/
